    "Gamma2": "362362186139658833615236535321328731560399075645184645709370180920216781823656668907225724463796/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "Gamma3": "4074071952671156008454660289930713760121058661593823670000945504041378548754352742908710721/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "A_inv": "2037035976334486289972043321857986787896037234603752355782979815948006363377381641621527353/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "P_1": "8570549695246346540400427691515681636467780502171291140505581136650737780527066682449937542/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "P_2": "4178338016459853739252497903667396001632306924873043173430226321187655089266204039065843204/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "base_degree": "1",
    "base_left": "1",
    "base_right": "1",
