{
  "format": "praxis-params/1",
  "title": "Praxis with alpha-scaled sparse quotient powers",
  "params": {
    "nu": "2048",
    "nc": "1694",
    "J": "8",
    "Delta": "482626",
    "Jp": "7",
    "dR": "32",
    "k": "116",
    "K1": "156",
    "K2": "12",
    "g": "92965769762883830223",
    "theta": "39614075911136747536592125061/31828687130226345097944463881396533766429193651030253916189694521162207808802136034115584",
    "beta": "2470743203925874612573916070966615131603301564416",
    "b": "66",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "3022415143007071/17179869184",
    "Gamma2": "562949953477607/281474976710656",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "4568091068271849/2251799813685248",
    "P_2": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 3*H2*q <= 2*beta**2 and 31*floor(H3)*q**2 <= 10*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "6*K2*(N+1) + 3*K2 + ceil((3*n/4)*(3*J+2*Jp+1) - 17/2) + 13*n"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "(3*n/2)*(3*J+2*Jp+1) + 26*n - 17"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "18*K2 + 4*J + 2*Jp + 4"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    }
  ]
}
