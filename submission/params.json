{
  "format": "praxis-params/1",
  "title": "Praxis with single-sector search on Boolean-tag extensions",
  "params": {
    "nu": "2048",
    "nc": "1692",
    "J": "14",
    "Delta": "524288",
    "Jp": "1",
    "dR": "4607",
    "k": "1",
    "K1": "128",
    "K2": "18",
    "g": "946767221281280",
    "theta": "2535300595993548995678819057664/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "beta": "105598212436945305544588294740711790084805825656726684931",
    "b": "49",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43362",
    "Lambda2": "696110000",
    "Lambda3": "9681500000000",
    "Gamma1": "32461896866",
    "Gamma2": "177901",
    "Gamma3": "4074071952671156018151847108594099670789879751351076135925958889196607110553456792174456227/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "A_inv": "2037035976334486289972043321857986787896037234603752355782979815948006363377381641621527353/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "P_1": "8570551280952365524485894007456879539583854543241697117858855635983145283545076564677435660/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "P_2": "4178339176061562633698744530528955275969259033608153048270257258986490333466026724443415772/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "base_degree": "1",
    "base_left": "1",
    "base_right": "1",
    "scalar_rel": "1",
    "ring_mode": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt((N+3)) and Lambda2 >= sqrt(2)*pi*R_tr**2*(N+3) and Lambda3 >= 20*pi*R_tr**3*(N+3)*sqrt((N+3))/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 649*floor(H3)*q**2 <= 250*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "(g**2 <= 2**40*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "ceil((6*K2*(N+4)+3*K2+(3*n/2)*(J+1)+(13*n-9))/2)"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "11*(3*n/2)+4*(D-1+ceil((D-1)/nu)+2+(nu-1)*nc)"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "4*((3*n/2)*(J+1)+(13*n-9))"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "21*K2+4*(6*K2+J+3)"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+4)+2*ceil((D-1)/nu)+Delta-Delta/nu"
    },
    {
      "id": "C6",
      "kind": "rule",
      "expr": "n >= 10 and n%2 == 0 and (q-1)%n == 0 and ring_mode == 1 and 2*n <= D and Delta >= n+3"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "base_degree == 1 and base_left == 1 and base_right == 1 and scalar_rel == 1 and K1 >= 1 and K2 >= 1 and 2*K1*K2 == n"
    },
    {
      "id": "dec_sum_g2",
      "kind": "def",
      "expr": "6*K2*((N+1)/2+12)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))"
    },
    {
      "id": "P1",
      "kind": "rule",
      "expr": "Delta <= D and J == ceil((D-1+nu*nc)/Delta) and Jp == 1 and Delta%nu == 0 and n <= D"
    },
    {
      "id": "C5",
      "kind": "rule",
      "expr": "(ring_mode == 0 and (k>=1 and ((is_pow2(dR) and (q-1)%(2*dR)==0) or (dR==144 and (q-1)%468==0)))) or (ring_mode == 1 and k == 1 and dR >= 512 and 2*dR <= D and dR < q and 56*dR < q-1)"
    },
    {
      "id": "n",
      "kind": "def",
      "expr": "k*dR + 1 + (1-ring_mode)*(dR-1)"
    },
    {
      "id": "H3",
      "kind": "def",
      "expr": "min(xi_tr/(g**3*mu_tr-xi_tr/g),ceil(g/max(1,ceil(g**4*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**4*mu_tr))*xi_tr/(g**3*mu_tr-xi_tr/g))"
    },
    {
      "id": "D",
      "kind": "def",
      "expr": "N+5+nu*nc"
    },
    {
      "id": "ell",
      "kind": "def",
      "expr": "ceil(N/dR)+3"
    },
    {
      "id": "Bsearch",
      "kind": "def",
      "expr": "(N+4)*(g+1)"
    },
    {
      "id": "T_tr",
      "kind": "def",
      "expr": "R_tr*g*sqrt((N+3)/3)"
    },
    {
      "id": "dec_sum_g1",
      "kind": "def",
      "expr": "(2*K1+1)*((N+1)/2+21)"
    },
    {
      "id": "search_spread",
      "kind": "def",
      "expr": "((20/37)*(2*sqrt(g*sqrt((N+7)/48)+3/2)+4*sqrt(g/sqrt(6)+1/2)+4000))**2"
    }
  ]
}
