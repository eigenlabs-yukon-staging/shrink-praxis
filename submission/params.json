{
  "format": "praxis-params/1",
  "title": "Praxis with a quadratic-base binomial and detector-enforced factor grid",
  "params": {
    "nu": "2048",
    "nc": "1696",
    "J": "9",
    "Delta": "429456",
    "Jp": "8",
    "dR": "1",
    "k": "3247",
    "K1": "136",
    "K2": "6",
    "g": "620262069315068755968",
    "theta": "39614075910531136704141336315/31828687130226345097944463881396533766429193651030253916189694521162207808802136034115584",
    "beta": "246879032734941908747460684759398460233435054080",
    "b": "69",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "5559720760279171/68719476736",
    "Gamma2": "4518814490512383/4503599627370496",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "4187346331296163/2251799813685248",
    "P_2": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 149*floor(H3)*q**2 <= 50*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "12*K2*(N+1) + 6*K2 + ceil((6*K1*K2*(3*J+2*Jp+1)-1)/2) + 135*n/2 + 36*K1 + 150*(K1*K2-n/4)-113"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "12*K1*K2 + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "6*K1*K2*(3*J+2*Jp+1)-1 + 2*(135*n/2 + 36*K1 + 150*(K1*K2-n/4)-113)"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "36*K2+4*J+2*Jp+4"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    },
    {
      "id": "C6",
      "kind": "rule",
      "expr": "dR == 1 and n % 4 == 0 and (q*q-1)%(n/2) == 0 and 2*n <= D and Delta >= n/2+3"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "K1 >= 1 and K2 >= 2 and 4*K1 <= n and 4*(K2-1)*K1 < n and n < 4*K1*K2 and 12*(K1*K2-n/4) <= n/2"
    },
    {
      "id": "dec_sum_g2",
      "kind": "def",
      "expr": "12*K2*(N+1)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1)"
    }
  ]
}
