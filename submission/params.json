    "P_1": "4438244634095512840213739304443041444832415656296214899756378904446719014500350300958055041/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "P_2": "2192205391936322020105274560417181934434912451947940533782502221344773476398974109811112257/2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376",
    "base_degree": "2",
