  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt((N+2)) and Lambda2 >= sqrt(2)*pi*R_tr**2*(N+2) and Lambda3 >= 20*pi*R_tr**3*(N+2)*sqrt((N+2))/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 2509*floor(H3)*q**2 <= 1000*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "(g**2 <= 2**40*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "ceil((6*K2*(N+3)+3*K2+(3*n/2)*(J+2)+C_mask)/2)"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "8*(3*n/2)+(D-1+ceil((D-1)/nu)+2+(nu-1)*nc)"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "4*((3*n/2)*(J+2)+C_mask)"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "12*K2+4*(6*K2+J+4)"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+3)+2*ceil((D-1)/nu)+Delta-Delta/nu + 2*(N+1)+1"
    },
    {
      "id": "C6",
      "kind": "rule",
      "expr": "n >= 10 and n%2 == 0 and ( (seed_mode == 0 and (q-1)%n == 0) or (seed_mode == 1 and n <= 4800 and seed_degree == 7 and n%(2*seed_degree) == 0 and n/seed_degree == 648 and ((q**seed_degree-1)**28)%648 == 0) ) and ring_mode == 1 and 2*n <= D and Delta >= n+3"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "base_degree == 1 and base_left == 1 and base_right == 1 and scalar_rel == 1 and K1 >= 1 and K2 >= 1 and 2*K1*K2 == n and ((seed_mode == 0 and C_mask == 13*n-9) or (seed_mode == 1 and K2 == 18 and 648%(2*K2) == 0 and q%648 == 505 and C_mask == 13*n-8*K2+4*(n-648+608)-5))"
    },
    {
      "id": "dec_sum_g2",
      "kind": "def",
      "expr": "6*K2*((N+1)/2+8)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))"
    },
    {
      "id": "P1",
      "kind": "rule",
      "expr": "Delta <= D and J == ceil((D-1+nu*nc)/Delta) and Jp == 1 and Delta%nu == 0 and n <= D"
    },
    {
      "id": "C5",
      "kind": "rule",
      "expr": "(ring_mode == 0 and (k>=1 and ((is_pow2(dR) and (q-1)%(2*dR)==0) or (dR==144 and (q-1)%468==0)))) or (ring_mode == 1 and k == 1 and dR >= 512 and 2*dR <= D and dR < q and 56*dR < q-1)"
    },
    {
      "id": "n",
      "kind": "def",
      "expr": "k*dR + 1 + (1-ring_mode)*(dR-1)"
    },
    {
      "id": "H3",
      "kind": "def",
      "expr": "min(xi_tr/(g**3*mu_tr-xi_tr/g),ceil(g/max(1,ceil(g**4*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**4*mu_tr))*xi_tr/(g**3*mu_tr-xi_tr/g))"
    },
    {
      "id": "D",
      "kind": "def",
      "expr": "N+4+nu*nc"
    },
    {
      "id": "ell",
      "kind": "def",
      "expr": "ceil(N/dR)+2"
    },
    {
      "id": "Bsearch",
      "kind": "def",
      "expr": "(N+3)*(g+1)"
    },
    {
      "id": "T_tr",
      "kind": "def",
      "expr": "R_tr*g*sqrt((N+2)/3)"
    },
    {
      "id": "dec_sum_g1",
      "kind": "def",
      "expr": "(2*K1+1)*((N+1)/2+8) + 2*(N+1)/2 + 40"
    },
    {
      "id": "search_spread",
      "kind": "def",
      "expr": "max(g*sqrt((N+6)/48)+3/2, ((20/37)*(2*sqrt((1-(197/1000)*min(1,floor(N/359994))-(51/10000)*min(1,floor(N/359994))*(1-min(1,floor(N/479995)))*min(1,floor(g/1000000000000)))*g*sqrt((N+6)/48)+3/2)+4*sqrt(g/4+1/2)+4010))**2)"
    }
  ]
}
