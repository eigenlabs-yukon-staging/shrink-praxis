    "Jp": "7",
    "dR": "1",
    "k": "3327",
    "K1": "128",
    "K2": "13",
    "g": "171196055425676401609",
    "theta": "19807037955592262468510006223/15914343565113172548972231940698266883214596825515126958094847260581103904401068017057792",
    "beta": "976025319315723577467022608835482643981978828800",
    "b": "67",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "6990123542622975/68719476736",
    "Gamma2": "670286732158277/562949953421312",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "8873085225910577/4503599627370496",
