  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 673*floor(H3)*q**2 <= 250*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "(g**2 <= 2**40*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "6*base_right*K2*(N+1)+3*base_right*K2+ceil(((3*n/2)*(2*J+2*Jp+1)+((54*base_degree-5*base_left-31)*(n/base_degree)+(-10*base_degree+10*base_left-2)*(K1/base_left)-29*base_degree-5*base_left+22-((10*base_degree+2*base_left-8)*(2*(K1/base_left)-q%(2*(K1/base_left)))+5*base_degree-5*base_left+1)))/2)"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "3*n + D - 1 + 3*ceil((D-1)/nu)+4 + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "(3*n/2)*(2*J+2*Jp+1)+((54*base_degree-5*base_left-31)*(n/base_degree)+(-10*base_degree+10*base_left-2)*(K1/base_left)-29*base_degree-5*base_left+22-((10*base_degree+2*base_left-8)*(2*(K1/base_left)-q%(2*(K1/base_left)))+5*base_degree-5*base_left+1))"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "18*base_right*K2+2*J+2*Jp+6"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+2)*(N+1) + 4*ceil((D-1)/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    },
    {
      "id": "C6",
      "kind": "rule",
      "expr": "base_degree == floor(base_degree) and base_degree >= 2 and base_degree <= 16 and (q-1)%base_degree == 0 and n%(2*base_degree) == 0 and (q**base_degree-1)**28%(n/base_degree) == 0 and 2*n <= D and Delta >= n/base_degree+base_degree+2 and (J == 1 or Delta%nu == 0)"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "base_left == floor(base_left) and base_right == floor(base_right) and base_left >= 1 and base_right >= 1 and base_left*base_right == base_degree and K1 >= base_left and K1%base_left == 0 and K2 >= 1 and 2*base_right*K1*K2 == n"
    },
    {
      "id": "dec_sum_g2",
      "kind": "def",
      "expr": "6*base_right*K2*(N+1)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))"
    },
    {
      "id": "H3",
      "kind": "def",
      "expr": "min(xi_tr/(g**3*mu_tr-xi_tr/g),ceil(g/max(1,ceil(g**4*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**4*mu_tr))*xi_tr/(g**3*mu_tr-xi_tr/g))"
    },
    {
      "id": "dec_sum_g1",
      "kind": "def",
      "expr": "(2*K1+2)*(N+1)/2"
    },
    {
      "id": "P1",
      "kind": "rule",
      "expr": "Delta <= D and J == ceil((D-1)/Delta) and n <= D"
    },
    {
      "id": "n",
      "kind": "def",
      "expr": "k*dR + max(1,ceil(forms_pad))"
    },
    {
      "id": "C5",
      "kind": "rule",
      "expr": "k>=1 and ((is_pow2(dR) and (q-1)%(2*dR)==0) or (dR==144 and (q-1)%468==0))"
    }
  ]
}
