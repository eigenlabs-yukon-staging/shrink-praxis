{
  "format": "praxis-params/1",
  "title": "Praxis with a padded factor grid and enforced dummy cells",
  "params": {
    "nu": "2048",
    "nc": "1694",
    "J": "8",
    "Delta": "482626",
    "Jp": "7",
    "dR": "1",
    "k": "3327",
    "K1": "139",
    "K2": "12",
    "g": "158969231780237344768",
    "theta": "9903518977795835315671271827/7957171782556586274486115970349133441607298412757563479047423630290551952200534008528896",
    "beta": "963266275287868972802495443994473120934418972672",
    "b": "67",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "3677470511402123/34359738368",
    "Gamma2": "1407374862266739/1125899906842624",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "2223257846176677/1125899906842624",
    "P_2": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 149*floor(H3)*q**2 <= 50*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "6*K2*(N+1) + 3*K2 + ceil((3*K1*K2*(3*J+2*Jp+1)-1)/2) + 26*K1*K2 + 16*n + 12*K1 + 24*(K1*K2-n/2) - 25"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "6*K1*K2 + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "3*K1*K2*(3*J+2*Jp+1)-1 + 2*(26*K1*K2+16*n+12*K1+24*(K1*K2-n/2)-25)"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "18*K2 + 4*J + 2*Jp + 4"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1)"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "K1 >= 1 and K2 >= 2 and 2*K1 <= n and 2*(K2-1)*K1 < n and n < 2*K1*K2 and 2*K1*K2 <= D and 6*(K1*K2-n/2) <= n and Delta >= 2*K1*K2-n+1"
    }
  ]
}
