{
  "format": "praxis-params/1",
  "title": "Praxis with a degree-twelve base and a binomial extension",
  "params": {
    "nu": "2048",
    "nc": "1694",
    "J": "8",
    "Delta": "482626",
    "Jp": "7",
    "dR": "1",
    "k": "3239",
    "K1": "135",
    "K2": "1",
    "g": "712405469642728013824",
    "theta": "4951759488899155135549421285/3978585891278293137243057985174566720803649206378781739523711815145275976100267004264448",
    "beta": "214947394761290496726111253710661126093948321792",
    "b": "69",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "2765382697739683/34359738368",
    "Gamma2": "2256814957960543/2251799813685248",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "8340646231921105/4503599627370496",
    "P_2": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 149*floor(H3)*q**2 <= 50*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "72*K2*(N+1) + 36*K2 + ceil(((3*n/2)*(3*J+2*Jp+1)-1)/2) + 711*n/12 + 92*K1 - 545"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "(3*n/2)*(3*J+2*Jp+1)-1 + 2*(711*n/12 + 92*K1 - 545)"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "216*K2+4*J+2*Jp+4"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    },
    {
      "id": "C6",
      "kind": "rule",
      "expr": "dR == 1 and n % 24 == 0 and (q**12-1)%(n/12) == 0 and 2*n <= D and Delta >= n/12+13"
    },
    {
      "id": "C7",
      "kind": "rule",
      "expr": "K1 >= 1 and K2 >= 1 and 24*K1*K2 == n"
    },
    {
      "id": "dec_sum_g2",
      "kind": "def",
      "expr": "72*K2*(N+1)"
    },
    {
      "id": "H2",
      "kind": "def",
      "expr": "min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1)"
    }
  ]
}
