{
  "format": "praxis-params/1",
  "title": "Praxis with dense inverse regularity and shared QAP powers",
  "params": {
    "nu": "2048",
    "nc": "1694",
    "J": "8",
    "Delta": "482626",
    "Jp": "7",
    "dR": "1",
    "k": "3327",
    "K1": "128",
    "K2": "13",
    "g": "179363410007128179043",
    "theta": "19807037955592262468510006223/15914343565113172548972231940698266883214596825515126958094847260581103904401068017057792",
    "beta": "976025319441240701391752069007308338042452836352",
    "b": "67",
    "eps_tr": "1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568",
    "R_tr": "20",
    "Lambda1": "43361",
    "Lambda2": "696098459",
    "Lambda3": "9681241716239",
    "Gamma1": "13302376278495/134217728",
    "Gamma2": "1308031771010559/1125899906842624",
    "Gamma3": "1",
    "A_inv": "562949953421875/562949953421312",
    "P_1": "4430281487722739/2251799813685248",
    "P_2": "1"
  },
  "amend": [
    {
      "id": "I3",
      "kind": "rule",
      "expr": "Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))"
    },
    {
      "id": "Ncmp",
      "kind": "func",
      "args": [
        "u"
      ],
      "expr": "u*(u+10)/8"
    },
    {
      "id": "I6",
      "kind": "rule",
      "expr": "2*beta < q and H1 <= beta and 3*H2*q <= 2*beta**2 and 31*floor(H3)*q**2 <= 10*beta**3"
    },
    {
      "id": "I4",
      "kind": "rule",
      "expr": "g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1"
    },
    {
      "id": "n2",
      "kind": "def",
      "expr": "6*K2*(N+1) + 3*K2 + (3*n/2)*(2*J+Jp) + 13*n - 8 + (3*n/2 - 1)"
    },
    {
      "id": "dec_msm_g1",
      "kind": "def",
      "expr": "3*n + J*Delta - 1 + (nu-1)*nc"
    },
    {
      "id": "dec_msm_g2",
      "kind": "def",
      "expr": "3*n*(2*J+Jp) + 29*n - 18"
    },
    {
      "id": "dec_pairings",
      "kind": "def",
      "expr": "18*K2 + 4*J + 2*Jp + 4"
    },
    {
      "id": "n1",
      "kind": "def",
      "expr": "(2*K1+1)*(N+1) + ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)"
    }
  ]
}
