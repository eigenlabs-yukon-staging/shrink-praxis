{
  "version": 1,
  "title": "Praxis with a quadratic-base binomial and detector-enforced factor grid",
  "claims": [
    "params.json is a parameter set of Praxis for the reference statement at 100-bit security whose ciphertext is 6772 MiB (6.6128 GiB) and whose time, one encryption plus one expected decryption, is 2090730 million field multiplications (20933 and 2069797), by the protected model, and every rule of the model as amended holds for it; proof.md proves that each amended entry (I3, Ncmp, I6, I4, n2, dec_msm_g1, dec_msm_g2, dec_pairings, n1, C6, C7, dec_sum_g2, H2) is sound, so that the paper's theorems hold for these parameters as rules.md requires."
  ],
  "experiments": [],
  "checks": [
    {
      "check": "praxis_gate",
      "inputs": {
        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with a quadratic-base binomial and detector-enforced factor grid\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1694\",\n    \"J\": \"8\",\n    \"Delta\": \"482626\",\n    \"Jp\": \"7\",\n    \"dR\": \"1\",\n    \"k\": \"3275\",\n    \"K1\": \"137\",\n    \"K2\": \"6\",\n    \"g\": \"383138464102061768704\",\n    \"theta\": \"79228151822378304055203985061/63657374260452690195888927762793067532858387302060507832379389042324415617604272068231168\",\n    \"beta\": \"399671956905414410455409481183262893225837330432\",\n    \"b\": \"68\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"5755771956109043/68719476736\",\n    \"Gamma2\": \"2284434591835709/2251799813685248\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"8575022470127053/4503599627370496\",\n    \"P_2\": \"1\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 149*floor(H3)*q**2 <= 50*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"12*K2*(N+1) + 6*K2 + ceil((6*K1*K2*(3*J+2*Jp+1)-1)/2) + 135*n/2 + 36*K1 + 150*(K1*K2-n/4)-113\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"12*K1*K2 + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K1*K2*(3*J+2*Jp+1)-1 + 2*(135*n/2 + 36*K1 + 150*(K1*K2-n/4)-113)\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"36*K2+4*J+2*Jp+4\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"C6\",\n      \"kind\": \"rule\",\n      \"expr\": \"dR == 1 and n % 4 == 0 and (q*q-1)%(n/2) == 0 and 2*n <= D and Delta >= n/2+3\"\n    },\n    {\n      \"id\": \"C7\",\n      \"kind\": \"rule\",\n      \"expr\": \"K1 >= 1 and K2 >= 2 and 4*K1 <= n and 4*(K2-1)*K1 < n and n < 4*K1*K2 and 12*(K1*K2-n/4) <= n/2\"\n    },\n    {\n      \"id\": \"dec_sum_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"12*K2*(N+1)\"\n    },\n    {\n      \"id\": \"H2\",\n      \"kind\": \"def\",\n      \"expr\": \"min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1)\"\n    }\n  ]\n}\n"
        ]
      }
    }
  ]
}
