        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with alpha-scaled sparse quotient powers\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1692\",\n    \"J\": \"3\",\n    \"Delta\": \"1285637\",\n    \"Jp\": \"3\",\n    \"dR\": \"32\",\n    \"k\": \"141\",\n    \"K1\": \"174\",\n    \"K2\": \"13\",\n    \"g\": \"946823879233298\",\n    \"theta\": \"79228151823424026526731484179/63657374260452690195888927762793067532858387302060507832379389042324415617604272068231168\",\n    \"beta\": \"139619931721506048482459863737191762109354836773188927488\",\n    \"b\": \"49\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"18794658385\",\n    \"Lambda3\": \"1254688926424562\",\n    \"Gamma1\": \"5182309944237387/32768\",\n    \"Gamma2\": \"1527997172005137/8589934592\",\n    \"Gamma3\": \"4503599627823269/2251799813685248\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"1184264754776437/281474976710656\",\n    \"P_2\": \"1154710703778429/562949953421312\",\n    \"forms_pad\": \"12\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"n\",\n      \"kind\": \"def\",\n      \"expr\": \"k*dR + max(1,ceil(forms_pad))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"H3\",\n      \"kind\": \"def\",\n      \"expr\": \"min(xi_tr/(g**3*mu_tr - xi_tr/g), g - 1 + ceil(max(0, 1-g/2**40, 4097/4096-g**4*mu_tr))*(xi_tr/(g**3*mu_tr - xi_tr/g)))\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2*(N+1) + 3*K2 + ceil((3*n/4)*(3*J+2*Jp+1) - 17/2) + 13*n\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\":