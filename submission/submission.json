"kind\": \"def\",\n      \"expr\": \"(3*n/2)*(2*J+2*Jp+1)+2*(13*n-8)\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"18*K2+2*J+2*Jp+6\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1)+4*ceil((D-1)/nu)+max(Delta,Deltap)-ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"P1\",\n      \"kind\": \"rule\",\n      \"expr\": \"Delta<=D and J==ceil((D-1)/Delta) and n<=D and (J==1 or Delta%nu==0)\"\n    },\n    {\n      \"id\": \"C5\",\n      \"kind\": \"rule\",\n      \"expr\": \"k>=1 and ((is_pow2(dR) and (q-1)%(2*dR)==0) or (dR==96 and (q-1)%208==0))\"\n    }\n  ]\n}\n"
