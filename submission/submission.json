        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with a quartic base, relative binomial and scalar ring with coefficient-first cancellation\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1694\",\n    \"J\": \"8\",\n    \"Delta\": \"482626\",\n    \"Jp\": \"7\",\n    \"dR\": \"1\",\n    \"k\": \"3239\",\n    \"K1\": \"135\",\n    \"K2\": \"3\",\n    \"g\": \"712405469642728013824\",\n    \"theta\": \"4951759488899155135549421285/3978585891278293137243057985174566720803649206378781739523711815145275976100267004264448\",\n    \"beta\": \"214947394761290496726111253710661126093948321792\",\n    \"b\": \"69\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"2765382697739683/34359738368\",\n    \"Gamma2\": \"2256814957960543/2251799813685248\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"8340646231921105/4503599627370496\",\n    \"P_2\": \"1\",\n    \"h_exp_2\": \"1\",\n    \"h_exp_3\": \"4\",\n    \"h_exp_5\": \"1\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 14*floor(H3)*q**2 <= 5*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"(g**2 <= 16*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"24*K2*(N+1) + 12*K2 + ceil(((3*n/2)*(3*J+2*Jp+1)-1)/2) + 180*n/4 + 28*K1 - 149\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"(3*n/2)*(3*J+2*Jp+1)-1+2*(180*n/4+28*K1-149)\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"72*K2+4*J+2*Jp+4\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"C6\",\n      \"kind\": \"rule\",\n      \"expr\": \"n == 4*2**h_exp_2*3**h_exp_3*5**h_exp_5 and h_exp_2 >= 1 and h_exp_3 >= 0 and h_exp_5 >= 0 and (q**4-1)%2 == 0 and (q**4-1)%3 == 0 and (q**4-1)%5 == 0 and 2*n <= D and Delta >= n/4+5\"\n    },\n    {\n      \"id\": \"C7\",\n      \"kind\": \"rule\",\n      \"expr\": \"K1 >= 1 and K2 >= 1 and 8*K1*K2 == n\"\n    },\n    {\n      \"id\": \"dec_sum_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"24*K2*(N+1)\"\n    },\n    {\n      \"id\": \"H2\",\n      \"kind\": \"def\",\n      \"expr\": \"min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))\"\n    }\n  ]\n}\n"
