        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with alpha-scaled sparse quotient powers\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1692\",\n    \"J\": \"6\",\n    \"Delta\": \"642819\",\n    \"Jp\": \"6\",\n    \"dR\": \"4\",\n    \"k\": \"1043\",\n    \"K1\": \"174\",\n    \"K2\": \"12\",\n    \"g\": \"127735940462570780\",\n    \"theta\": \"79228151823498920830104929269/63657374260452690195888927762793067532858387302060507832379389042324415617604272068231168\",\n    \"beta\": \"802669146523937769485186012308907235121386721548173312\",\n    \"b\": \"56\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"2070053939736775/262144\",\n    \"Gamma2\": \"4268632604491565/68719476736\",\n    \"Gamma3\": \"562949955125917/562949953421312\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"3300907057303255/1125899906842624\",\n    \"P_2\": \"1612907351785659/1125899906842624\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 14*floor(H3)*q**2 <= 5*beta**3\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2*(N+1) + 3*K2 + ceil((3*n/4)*(3*J+2*Jp+1) - 17/2) + 13*n\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec