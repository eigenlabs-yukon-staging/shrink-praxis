1+ceil(max(0,(1+1/sqrt(g))**256-g**4*mu_tr))*xi_tr/(g**3*mu_tr-xi_tr/g))\"\n    },\n    {\n      \"id\": \"C6\",\n      \"kind\": \"rule\",\n      \"expr\": \"n % 2 == 0 and n == 2**n_exp_2*3**n_exp_3*13**n_exp_13*29**n_exp_29*983**n_exp_983 and n_exp_2 >= 1 and n_exp_3 >= 0 and n_exp_13 >= 0 and n_exp_29 >= 0 and n_exp_983 >= 0 and 2*n <= D and Delta >= 2*n+2 and (J-1)*Delta<=D-n-2\"\n    }\n  ]\n}\n"
