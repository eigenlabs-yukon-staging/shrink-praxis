        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis at degree 3364 with a broadened binomial field and a padded factor grid\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1694\",\n    \"J\": \"8\",\n    \"Delta\": \"482626\",\n    \"Jp\": \"7\",\n    \"dR\": \"32\",\n    \"k\": \"105\",\n    \"K1\": \"153\",\n    \"K2\": \"11\",\n    \"g\": \"92965787417051103232\",\n    \"theta\": \"19807037955588980462399531977/15914343565113172548972231940698266883214596825515126958094847260581103904401068017057792\",\n    \"beta\": \"1647162317220476969212888074883459441827579428864\",\n    \"b\": \"66\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"6044830259993445/34359738368\",\n    \"Gamma2\": \"562949953477607/281474976710656\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"4568091048607953/2251799813685248\",\n    \"P_2\": \"1\",\n    \"n_exp_2\": \"2\",\n    \"n_exp_3\": \"0\",\n    \"n_exp_13\": \"0\",\n    \"n_exp_29\": \"2\",\n    \"n_exp_983\": \"0\",\n    \"forms_pad\": \"4\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 14*floor(H3)*q**2 <= 5*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"(g**2 <= 16*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2*(N+1)+3*K2+ceil((3*K1*K2*(3*J+2*Jp+1)-1)/2)+(37*n+14*K1+24*(K1*K2-n/2)-35)\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K1*K2+J*Delta-1+J*ceil(Delta/nu)+(nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"3*K1*K2*(3*J+2*Jp+1)-1+2*(37*n+14*K1+24*(K1*K2-n/2)-35)\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"18*K2 + 4*J + 2*Jp + 4\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"C6\",\n      \"kind\": \"rule\",\n      \"expr\": \"n % 2 == 0 and n == 2**n_exp_2*3**n_exp_3*13**n_exp_13*29**n_exp_29*983**n_exp_983 and n_exp_2 >= 1 and n_exp_3 >= 0 and n_exp_13 >= 0 and n_exp_29 >= 0 and n_exp_983 >= 0 and 2*n <= D and Delta >= 2*n+2\"\n    },\n    {\n      \"id\": \"n\",\n      \"kind\": \"def\",\n      \"expr\": \"k*dR + max(1,ceil(forms_pad))\"\n    },\n    {\n      \"id\": \"C7\",\n      \"kind\": \"rule\",\n      \"expr\": \"n >= 6 and K1 >= 1 and K2 >= 2 and 2*K1 <= n and 2*(K2-1)*K1 < n and n <= 2*K1*K2 and 2*K1*K2 <= D and 6*(K1*K2-n/2) <= n and Delta >= 2*K1*K2-n+1\"\n    },\n    {\n      \"id\": \"H2\",\n      \"kind\": \"def\",\n      \"expr\": \"min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))\"\n    }\n  ]\n}\n"
