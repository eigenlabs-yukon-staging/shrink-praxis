          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with a degree-96 cyclotomic Module-SIS ring\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1692\",\n    \"J\": \"5\",\n    \"Delta\": \"772096\",\n    \"Jp\": \"4\",\n    \"dR\": \"96\",\n    \"k\": \"47\",\n    \"K1\": \"174\",\n    \"K2\": \"13\",\n    \"g\": \"946823879233298\",\n    \"theta\": \"9903518977927465282052833187/7957171782556586274486115970349133441607298412757563479047423630290551952200534008528896\",\n    \"beta\": \"139619931721506048482459863737191762109354836773188927488\",\n    \"b\": \"49\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"18794658385\",\n    \"Lambda3\": \"1254688926424562\",\n    \"Gamma1\": \"5182309944237387/32768\",\n    \"Gamma2\": \"1527997172005137/8589934592\",\n    \"Gamma3\": \"4503599627823269/2251799813685248\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"1184264754776437/281474976710656\",\n    \"P_2\": \"1154710703778429/562949953421312\",\n    \"forms_pad\": \"12\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"n\",\n      \"kind\": \"def\",\n      \"expr\": \"k*dR + max(1,ceil(forms_pad))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"H3\",\n      \"kind\": \"def\",\n      \"expr\": \"min(xi_tr/(g**3*mu_tr - xi_tr/g), g - 1 + ceil(max(0, 1-g/2**40, 4097/4096-g**4*mu_tr))*(xi_tr/(g**3*mu_tr - xi_tr/g)))\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2*(N+1)+3*K2+ceil(((3*n/2)*(2*J+2*Jp+1)+1*(13*n-8))/2)\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n+D-1+3*ceil((D-1)/nu)+4+(nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"(3*n/2)*(2*J+2*Jp+1)+1*(13*n-8)\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"18*K2+2*J+2*Jp+6\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+2)*(N+1)+4*ceil((D-1)/nu)+max(Delta,Deltap)-ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"P1\",\n      \"kind\": \"rule\",\n      \"expr\": \"Delta<=D and J==ceil((D-1)/Delta) and n<=D and (J==1 or Delta%nu==0)\"\n    },\n    {\n      \"id\": \"dec_sum_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+2)*(N+1)/2\"\n    },\n    {\n      \"id\": \"C5\",\n      \"kind\": \"rule\",\n      \"expr\": \"k>=1 and ((is_pow2(dR) and (q-1)%(2*dR)==0) or (dR==96 and (q-1)%208==0))\"\n    }\n  ]\n}\n"
