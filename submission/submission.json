{
  "version": 1,
  "title": "Praxis with an integer ceiling bound for dense rank-two heights",
  "claims": [
    "params.json is a parameter set of Praxis for the reference statement at 100-bit security whose ciphertext is 6822 MiB (6.6619 GiB) and whose time, one encryption plus one expected decryption, is 1355789 million field multiplications (21173 and 1334616), by the protected model, and every rule of the model as amended holds for it; proof.md proves that each amended entry (I3, Ncmp, I6, I4, n2, dec_msm_g1, dec_msm_g2, dec_pairings, n1, H2) is sound, so that the paper's theorems hold for these parameters as rules.md requires."
  ],
  "experiments": [],
  "checks": [
    {
      "check": "praxis_gate",
      "inputs": {
        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with an integer ceiling bound for dense rank-two heights\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1694\",\n    \"J\": \"8\",\n    \"Delta\": \"482626\",\n    \"Jp\": \"7\",\n    \"dR\": \"1\",\n    \"k\": \"3327\",\n    \"K1\": \"128\",\n    \"K2\": \"13\",\n    \"g\": \"158969231780237344768\",\n    \"theta\": \"19807037955592262468510006223/15914343565113172548972231940698266883214596825515126958094847260581103904401068017057792\",\n    \"beta\": \"963266275287868972802495443994473120934418972672\",\n    \"b\": \"67\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"3677470511402123/34359738368\",\n    \"Gamma2\": \"1407374862266739/1125899906842624\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"2223257846176677/1125899906842624\",\n    \"P_2\": \"1\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 149*floor(H3)*q**2 <= 50*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2*(N+1) + 3*K2 + ceil((3*n/4)*(3*J+2*Jp+1) - 17/2) + 13*n\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"(3*n/2)*(3*J+2*Jp+1) + 26*n - 17\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"18*K2 + 4*J + 2*Jp + 4\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1) + 2*ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"H2\",\n      \"kind\": \"def\",\n      \"expr\": \"min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1)\"\n    }\n  ]\n}\n"
        ]
      }
