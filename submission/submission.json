{
  "version": 1,
  "title": "Praxis with linear weights and two-dimensional heavy extraction",
  "claims": [
    "params.json is a parameter set of Praxis for the reference statement at 100-bit security whose ciphertext is 5864 MiB (5.7261 GiB) and whose time, one encryption plus one expected decryption, is 1036093 million field multiplications (15016 and 1021077), by the protected model, and every rule of the model as amended holds for it; proof.md proves that each amended entry (I3, Ncmp, I6, I4, C7, n2, dec_sum_g2, dec_msm_g1, dec_msm_g2, dec_pairings) is sound, so that the paper's theorems hold for these parameters as rules.md requires."
  ],
  "experiments": [],
  "checks": [
    {
      "check": "praxis_gate",
      "inputs": {
        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with linear weights and two-dimensional heavy extraction\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1695\",\n    \"J\": \"16\",\n    \"Delta\": \"241441\",\n    \"Jp\": \"15\",\n    \"dR\": \"32\",\n    \"k\": \"115\",\n    \"K1\": \"128\",\n    \"K2\": \"29\",\n    \"g\": \"92973447821963051008\",\n    \"theta\": \"262143/210624583337114373395836055367340864637790190801098222508621955072\",\n    \"beta\": \"2470543707157887423680161288369481123409088741376\",\n    \"b\": \"66\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"6044815267533461/34359738368\",\n    \"Gamma2\": \"562949953477607/281474976710656\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"35688122802923/17592186044416\",\n    \"P_2\": \"1\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 3*H2*q <= 2*beta**2 and 31*floor(H3)*q**2 <= 10*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"g >= 2**40 and g**3*mu_tr >= 4097/4096 and Gamma2 >= xi_tr*(2-1/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1\"\n    },\n    {\n      \"id\": \"C7\",\n      \"kind\": \"rule\",\n      \"expr\": \"K1 >= 1 and K2 >= 2 and K1*K2 == n\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*K2*(N+1) + K2 + n*(J+Jp) + 4*n - 2\"\n    },\n    {\n      \"id\": \"dec_sum_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*K2*(N+1)\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"2*n + 2*J*Delta + (nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*n*(J+Jp) + 8*n - 4\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"6*K2 + 4*J + 2*Jp + 2\"\n    }\n  ]\n}\n"
        ]
      }
    }
  ]
}
