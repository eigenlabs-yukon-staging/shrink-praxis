          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with a quadratic-base field and the full rank-three inverse\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1692\",\n    \"J\": \"7\",\n    \"Delta\": \"550988\",\n    \"Jp\": \"6\",\n    \"dR\": \"8\",\n    \"k\": \"531\",\n    \"K1\": \"152\",\n    \"K2\": \"7\",\n    \"g\": \"39701739941176144\",\n    \"theta\": \"4951759488967902402888084693/3978585891278293137243057985174566720803649206378781739523711815145275976100267004264448\",\n    \"beta\": \"2582499228089326627051199246457436324986057008164634624\",\n    \"b\": \"55\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"592180936470841/65536\",\n    \"Gamma2\": \"4585370990915789/68719476736\",\n    \"Gamma3\": \"140737533870319/140737488355328\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"1758127432429561/562949953421312\",\n    \"P_2\": \"3465173463139193/2251799813685248\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 14*floor(H3)*q**2 <= 5*beta**3\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"12*K2*(N+1) + 6*K2 + ceil(((3*n/2)*(3*J+2*Jp+1)-1)/2) + 81*n/2 + 12*K1 - 65\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"3*n + J*Delta - 1 + J*ceil(Delta/nu) + (nu-1)*nc\"\n    },\