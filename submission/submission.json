{
  "version": 1,
  "title": "Praxis with one weight family in a guarded odd extension",
  "claims": [
    "params.json is a parameter set of Praxis for the reference statement at 100-bit security whose ciphertext is 5598 MiB (5.4666 GiB) and whose time, one encryption plus one expected decryption, is 1034601 million field multiplications (14410 and 1020192), by the protected model, and every rule of the model as amended holds for it; proof.md proves that each amended entry (I3, Ncmp, I6, I4, n2, dec_msm_g1, dec_msm_g2, dec_pairings, n1, C7, dec_sum_g2, H2, C6) is sound, so that the paper's theorems hold for these parameters as rules.md requires."
  ],
  "experiments": [],
  "checks": [
    {
      "check": "praxis_gate",
      "inputs": {
        "params": [
          "{\n  \"format\": \"praxis-params/1\",\n  \"title\": \"Praxis with one weight family in a guarded odd extension\",\n  \"params\": {\n    \"nu\": \"2048\",\n    \"nc\": \"1696\",\n    \"J\": \"9\",\n    \"Delta\": \"429456\",\n    \"Jp\": \"8\",\n    \"dR\": \"32\",\n    \"k\": \"105\",\n    \"K1\": \"117\",\n    \"K2\": \"29\",\n    \"g\": \"92965787417051103232\",\n    \"theta\": \"79228151821035371718852555859/63657374260452690195888927762793067532858387302060507832379389042324415617604272068231168\",\n    \"beta\": \"1647162317220476969212888074883459441827579428864\",\n    \"b\": \"66\",\n    \"eps_tr\": \"1/60708402882054033466233184588234965832575213720379360039119137804340758912662765568\",\n    \"R_tr\": \"20\",\n    \"Lambda1\": \"43361\",\n    \"Lambda2\": \"696098459\",\n    \"Lambda3\": \"9681241716239\",\n    \"Gamma1\": \"6044830259993445/34359738368\",\n    \"Gamma2\": \"562949953477607/281474976710656\",\n    \"Gamma3\": \"1\",\n    \"A_inv\": \"562949953421875/562949953421312\",\n    \"P_1\": \"4568091048607953/2251799813685248\",\n    \"P_2\": \"1\",\n    \"one_family\": \"1\"\n  },\n  \"amend\": [\n    {\n      \"id\": \"I3\",\n      \"kind\": \"rule\",\n      \"expr\": \"Lambda1 >= 2*sqrt(3)*R_tr*sqrt(N) and Lambda2 >= sqrt(2)*pi*R_tr**2*N and Lambda3 >= 20*pi*R_tr**3*N*sqrt(N)/(9*sqrt(2))\"\n    },\n    {\n      \"id\": \"Ncmp\",\n      \"kind\": \"func\",\n      \"args\": [\n        \"u\"\n      ],\n      \"expr\": \"u*(u+10)/8\"\n    },\n    {\n      \"id\": \"I6\",\n      \"kind\": \"rule\",\n      \"expr\": \"2*beta < q and H1 <= beta and 4*H2*q <= 3*beta**2 and 14*floor(H3)*q**2 <= 5*beta**3\"\n    },\n    {\n      \"id\": \"I4\",\n      \"kind\": \"rule\",\n      \"expr\": \"(g**2 <= 16*2**lam and Gamma3 >= xi_tr*(1 + H3/g) and A_inv >= mu_tr/(mu_tr - eps_tr) and P_2**(b-1) >= (g**(-3) + eps_tr)/mu_tr and P_1**(b-1) >= (g**(-2) + 2*eps_tr)/mu_tr and Gamma2**(b-1) >= g**(-2)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma2 >= A_inv*Lambda1*Gamma3*P_2 and Gamma1 >= A_inv*max(Lambda1*Gamma2, Lambda2*Gamma3)*P_1) or (g**2 <= 2**40*2**lam and g**3*mu_tr > (1 + 1/sqrt(g))**255 and Gamma2 >= xi_tr*(1 + min(g-1,xi_tr/(g**2*mu_tr-xi_tr/g))/g) and A_inv >= mu_tr/(mu_tr-eps_tr) and P_1**(b-1) >= (g**(-2)+2*eps_tr)/mu_tr and Gamma1**(b-1) >= g**(-1)/mu_tr and Gamma1 >= A_inv*Lambda1*Gamma2*P_1)\"\n    },\n    {\n      \"id\": \"n2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*(K2*(3-2*one_family))*(N+1)+(K2*(3-2*one_family))+((K1*(K2*(3-2*one_family)))*(2*J+Jp)+(K1*(K2*(3-2*one_family)))-1+((1-one_family)*(13*n-8)+one_family*(5*K1*K2-3)))\"\n    },\n    {\n      \"id\": \"dec_msm_g1\",\n      \"kind\": \"def\",\n      \"expr\": \"2*(K1*(K2*(3-2*one_family)))+J*Delta-1+(nu-1)*nc\"\n    },\n    {\n      \"id\": \"dec_msm_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*((K1*(K2*(3-2*one_family)))*(2*J+Jp)+(K1*(K2*(3-2*one_family)))-1+((1-one_family)*(13*n-8)+one_family*(5*K1*K2-3)))\"\n    },\n    {\n      \"id\": \"dec_pairings\",\n      \"kind\": \"def\",\n      \"expr\": \"6*(K2*(3-2*one_family))+4*J+2*Jp+4\"\n    },\n    {\n      \"id\": \"n1\",\n      \"kind\": \"def\",\n      \"expr\": \"(2*K1+1)*(N+1) + ceil(Delta/nu) + max(Delta,Deltap) - ceil(max(Delta,Deltap)/nu)\"\n    },\n    {\n      \"id\": \"C7\",\n      \"kind\": \"rule\",\n      \"expr\": \"K1>=1 and K2>=1 and ((one_family==0 and 2*K1*K2==n) or (one_family==1 and K1<=n and K1<D and K1*K2>=n and K1*K2<=2*n and 2*K1*K2<=D and (K1*K2)%2==1 and (q-1)%(K1*K2)==0 and Delta>=K1*K2-n+1 and g**(-3)<mu_tr))\"\n    },\n    {\n      \"id\": \"dec_sum_g2\",\n      \"kind\": \"def\",\n      \"expr\": \"2*(K2*(3-2*one_family))*(N+1)\"\n    },\n    {\n      \"id\": \"H2\",\n      \"kind\": \"def\",\n      \"expr\": \"min(Gamma2/(g**2*mu_tr),ceil(g/max(1,ceil(g**3*mu_tr/(1+1/sqrt(g))**255)-1))-1+ceil(max(0,(1+1/sqrt(g))**256-g**3*mu_tr))*Gamma2/(g**2*mu_tr))\"\n    },\n    {\n      \"id\": \"C6\",\n      \"kind\": \"rule\",\n      \"expr\": \"n>=2 and (one_family==1 or (one_family==0 and n%2==0 and (q-1)%n==0))\"\n    }\n  ]\n}\n"
        ]
      }
    }
  ]
